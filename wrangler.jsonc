{
  // Normative copy lives in docs/01 §5.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ticktune",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Serves dist/404.html for unknown paths — this is the whole 404 story,
    // no zone feature needed (docs/10 §3).
    "not_found_handling": "404-page",
  },

  // No public *.workers.dev hostname: ticktune.net is the only production
  // origin, and a second copy of the site on another host would split SEO and
  // dodge the zone's WAF and rate-limit rules (docs/10 §5–§6).
  "workers_dev": false,

  // …but Version URLs ARE on (docs/14 §5). Production deploys only from a
  // signed tag (deploy.yml); every other build — each PR and each push to main —
  // runs `wrangler versions upload` in Cloudflare Workers Builds, and the URL it
  // returns is where the manual live checklist runs before a merge. With
  // `workers_dev` false, Version URLs default to OFF, so this must be explicit.
  "preview_urls": true,

  // 🔴 This setting is DISCLOSED in legal/PRIVACY-POLICY.md. It is not a free
  // debug toggle: enabled, it writes one invocation log per Worker call —
  // request, response, and Cloudflare's country — retained 7 days on Workers
  // Paid (3 on Free), and it does so even though worker/index.ts never calls
  // console.log.
  //
  // The policy once said we store "no server-side logs of its own about you"
  // while this was on. That cost a TT_LEGAL_VERSION bump and re-prompted every
  // existing user, because consent to an inaccurate description is not consent.
  //
  // Kept on deliberately: it is the only way to see WHY an oEmbed lookup failed
  // in production, which is the endpoint's entire job (docs/06 §3, spike S1).
  // Its blast radius is small because `run_worker_first` is unset — static pages
  // are served without invoking the Worker, so browsing the site logs nothing.
  //
  // Changing this block — or the account's plan, which sets the retention —
  // changes the privacy policy. Do one without the other and the document is
  // false again.
  "observability": {
    "enabled": true,
  },
}
