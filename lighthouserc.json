{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm astro preview --port 4339",
      "startServerReadyPattern": "4339",
      "url": [
        "http://localhost:4339/",
        "http://localhost:4339/en/",
        "http://localhost:4339/legal/privacy/"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "blockedUrlPatterns": ["*cloudflareinsights.com*"]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": "lhci-report" }
  }
}
