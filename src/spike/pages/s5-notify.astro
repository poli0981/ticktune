---
import TtBase from '../../layouts/TtBase.astro';
---

<TtBase title="spike/s5-notify — TickTune" noindex analytics={false}>
  <!--
    THROWAWAY harness — docs/15 §S5. Routed ONLY by `astro dev` or a
    `TT_SPIKES=1` build into dist-spikes/ (ttSpikeRoutes in astro.config.mjs),
    never by the dist/ that CI tests and deploy.yml ships.
  -->
  <div id="tt-spike"></div>
  <script>
    if (!document.documentElement.dataset.ttBlocked) {
      import('../s5/mount-s5.ts');
    }
  </script>
</TtBase>
