---
import '../styles/global.css';
/*
 * The faces every page draws its first screen with (v2.0), as URLs — the
 * same hashed files the fontsource CSS links, so a preload and the CSS fetch
 * are one request. Without them the prose painted in the fallback and
 * re-wrapped when Be Vietnam Pro swapped in: Lighthouse CLS ~0.19 on every
 * legal page, the whole column jumping. The `vietnamese` subset is preloaded
 * because the default language needs it on the first line.
 */
import uiLatin from '@fontsource/be-vietnam-pro/files/be-vietnam-pro-latin-400-normal.woff2?url';
import uiVietnamese from '@fontsource/be-vietnam-pro/files/be-vietnam-pro-vietnamese-400-normal.woff2?url';
import displayLatin from '@fontsource/chakra-petch/files/chakra-petch-latin-600-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  lang?: 'vi' | 'en' | 'ja';
  /** Throwaway spike pages set this — they are not product surface. */
  noindex?: boolean;
  /**
   * docs/08 §1's "hreflang alternates + lang attribute per route".
   *
   * Each page passes its own reciprocal set including `x-default`, e.g. the VI
   * landing passes vi→`/`, en→`/en/`, x-default→`/`. Defaults to empty so
   * `/app/` and the spike pages emit nothing and are unaffected.
   *
   * In-page `rel="alternate"` is what search engines read, and it is the
   * "hreflang correct" P6 exit criterion — the sitemap deliberately does not
   * duplicate it (see astro.config.mjs).
   */
  alternates?: { hreflang: string; href: string }[];
  /** Social-card image, same-origin. Overridable per page. */
  ogImage?: string;
  /**
   * The spike harnesses pass `false`. They run on localhost in browsers the
   * measurement scripts launch for real, where tests/e2e/_fixtures.ts cannot
   * fulfil the beacon — and a harness run is not a visit.
   */
  analytics?: boolean;
  /**
   * The web app manifest — /app/ only (docs/10 §9, v2.0). Its scope and start
   * URL are /app/, which is all the service worker controls; the landing and
   * the legal pages stay plain pages.
   */
  manifest?: boolean;
}

const {
  title = 'TickTune',
  description = 'Đếm ngược toàn màn hình với nhạc của riêng bạn. Chạy hoàn toàn trên máy bạn.',
  lang = 'vi',
  noindex = false,
  alternates = [],
  ogImage = '/og/ticktune.png',
  analytics = true,
  manifest = false,
} = Astro.props;

const repo = 'https://github.com/poli0981/ticktune';

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
---

<!doctype html>
<html {lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {manifest && <link rel="manifest" href="/manifest.webmanifest" />}
    {manifest && <meta name="theme-color" content="#0e0d0b" />}

    {/* docs/08 §1 — reciprocal per route; empty on /app/ and the spikes. */}
    {alternates.map((a) => (
      <link rel="alternate" hreflang={a.hreflang} href={a.href} />
    ))}

    {/*
      Open Graph + Twitter. Pure <meta>, so no CSP implication: the image is
      fetched by the crawler from our origin, never by this page.
    */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="TickTune" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content={{ vi: 'vi_VN', en: 'en_US', ja: 'ja_JP' }[lang]} />
    <meta name="twitter:card" content="summary_large_image" />

    {/* The first screen's faces, fetched before the CSS asks — see the imports. */}
    {[uiLatin, uiVietnamese, displayLatin].map((href) => (
      <link rel="preload" href={href} as="font" type="font/woff2" crossorigin="anonymous" />
    ))}

    {/*
      Favicon — self-hosted, the "On Air" tally dot. SVG first with a PNG
      fallback for the browsers and crawlers that ignore SVG icons.
    */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {/*
      Mobile gate — docs/07 §2/§3.1. MUST stay `is:inline` and MUST run before
      the parser reaches any module script, so the attribute is set before first
      paint: no flash, no layout shift.

      This is the ONLY inline script on the entire site, and it must be
      byte-identical on every page — scripts/inject-csp-hash.ts asserts exactly
      one distinct hash and fails the build otherwise (docs/10 §7). Do not
      parameterise it, and do not add a second inline script anywhere.

      Kept in sync by hand with ttIsBlocked() in src/lib/tt-gate-const.ts, which
      is the source of truth for the criteria (TT_GATE: minWidth 1024,
      blockCoarseOnly). Evaluated once, deliberately: resizing a desktop window
      below 1024 px mid-session must not eject the user.
    */}
    <script is:inline>
      if (
        window.innerWidth < 1024 ||
        (matchMedia('(pointer: coarse)').matches && !matchMedia('(hover: hover)').matches)
      ) {
        document.documentElement.dataset.ttBlocked = '1';
      }
    </script>
    {/*
      Cloudflare Web Analytics — every page, /app/ included (decided 2026-10-20).

      The ONLY telemetry TickTune has, and it is disclosed: legal/PRIVACY-POLICY.md
      §3-§4 (EN + VI), the Legal Gate's own summary, and the CSP in docs/09 §4,
      which gains exactly two origins for it — `static.cloudflareinsights.com`
      (this script) and `cloudflareinsights.com` (where it reports). It reads
      page-level timing only; it has no access to anything the app holds.

      An EXTERNAL module script, so the one-inline-script rule that
      scripts/inject-csp-hash.ts enforces is untouched (it skips any tag with a
      `src`). The manual snippet, not the zone's automatic injection: automatic
      injection inserts an inline bootstrap the CSP rightly blocks (docs/10 §10),
      and running both would count every visit twice.

      E2E never sends real beacons: tests/e2e/_fixtures.ts fulfils both origins
      with an empty response for every spec.
    */}
    {analytics && (
      <script
        is:inline
        type="module"
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon='{"token": "46c4fdb729df436091a0cb204d77dcc7"}'
      ></script>
    )}
  </head>

  <body>
    <slot />

    {/*
      Always rendered, hidden by default; CSS in global.css reveals it when
      data-tt-blocked is present and visually hides everything else. The page's
      real HTML deliberately STAYS in the DOM underneath — that is the SEO
      mitigation in docs/07 §5. Never swap it out, and never UA-sniff crawlers.
    */}
    <div class="tt-mobile-gate fixed inset-0 z-(--tt-z-mobile-gate) flex-col items-center justify-center overflow-y-auto bg-tt-void [background-image:var(--tt-grain),radial-gradient(110%_70%_at_50%_0%,rgb(255_178_63/7%),transparent_65%)] p-6">
      {/*
        v1.1 "Rack Unit": the notice is a powered-down module on the chassis —
        tally lamp idle (docs/03 §1), engraved product plate, status LEDs dark.
        Utilities and global.css primitives only: this layout carries no <style>,
        and `display` stays global.css's (it shows the overlay only when blocked).
      */}
      <div class="tt-panel relative flex w-full max-w-sm flex-col items-center gap-5 px-6 pt-4 pb-7 text-center">
        <div class="flex w-full items-center justify-between border-b border-black/60 pb-3 shadow-[0_1px_0_rgb(255_255_255/4%)]">
          <span class="flex items-center gap-2">
            <span
              class="inline-block size-2.5 rounded-full bg-tt-muted shadow-[inset_0_0_0_1px_rgb(0_0_0/45%)]"
              aria-hidden="true"
            ></span>
            <span class="tt-label">TickTune</span>
          </span>
          <span class="flex gap-2" aria-hidden="true">
            <span class="tt-led"></span>
            <span class="tt-led"></span>
            <span class="tt-led"></span>
          </span>
        </div>

        {/* Trilingual and hardcoded — no JS i18n runs on mobile (docs/07 §4). HTML
            only, so the gate's inline script — and the CSP hash — are untouched. */}
        <p
          lang="vi"
          class="font-display text-lg leading-snug font-semibold text-balance text-tt-text"
        >
          Xin lỗi — TickTune không hỗ trợ thiết bị di động.
          <br />
          Vui lòng mở bằng trình duyệt trên máy tính.
        </p>
        <p lang="en" class="text-sm leading-relaxed text-balance text-tt-muted">
          Sorry — TickTune isn't available on mobile.
          <br />
          Please use a desktop browser and try again.
        </p>
        <p lang="ja" class="text-sm leading-relaxed text-balance text-tt-muted">
          申し訳ありません — TickTune はモバイル端末に対応していません。
          <br />
          パソコンのブラウザーでお試しください。
        </p>

        <a
          href={repo}
          rel="noopener noreferrer"
          class="font-mono text-xs text-tt-signal underline decoration-tt-outline underline-offset-4 hover:decoration-tt-signal"
        >
          github.com/poli0981/ticktune
        </a>
      </div>
    </div>
  </body>
</html>
