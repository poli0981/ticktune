---
import type { StaticDict } from '../../i18n/static/en';

/**
 * Landing hero — docs/03 §3 item 1.
 *
 * "hero with looping demo capture (placeholder asset until core is done, per
 * spec)". ✅ **P7 slice C cleared the placeholder** — this is now a real
 * recording of the shipped app, produced by `scripts/make-demo.ts`, and
 * `docs/16`'s standing rule is satisfied by there being nothing left to track.
 *
 * Everything is same-origin (`img-src`/`media-src 'self'`), so the CSP is
 * unchanged — the same reason the placeholder needed none.
 *
 * Zero JS, like every static section: the site ships exactly one inline script
 * (the mobile gate in TtBase) and `scripts/inject-csp-hash.ts` fails the build
 * on a second one.
 *
 * v1.1 "Rack Unit": the capture sits in a rack monitor — bezel, screws, an ON
 * AIR sign, a strip of seven-segment readouts — and the hero runs one CSS-only
 * power-on sequence on load. Two rules shape that sequence:
 *
 * - **Text is never faded.** axe blends an element's opacity into its contrast
 *   maths and scans the page while the sequence is still running, so a fade on
 *   text is a contrast failure waiting for a slow machine. Text is revealed
 *   with `clip-path` and `transform`; only decoration and media change opacity.
 * - **Every animation lives inside `prefers-reduced-motion: no-preference`.**
 *   The global reduced-motion rule shortens durations but not delays, so a
 *   delayed animation would still hold its first frame — the motion has to be
 *   absent, not merely fast.
 */

interface Props {
  t: StaticDict['landing'];
  common: StaticDict['common'];
}

const { t, common } = Astro.props;

/**
 * One line per sentence, so the headline stacks as three statements and each
 * gets its own beat of the power-on. The separating space stays in the DOM:
 * the heading's text is byte-identical to the dictionary's.
 */
const lines = t.heroHeadline.split(/(?<=[.!?])\s+/);

/**
 * The readout strip under the monitor, derived from the limits table's own rows
 * so no figure is ever typed a second time (CLAUDE.md invariant 4: the limits
 * are spec). A row qualifies when its limit names exactly one figure — "up to
 * 95 files" → 95; "1 second to 24 hours" names two and stays in the table — and
 * a figure already shown is not repeated. The strip is decorative
 * (`aria-hidden`): the table below says the same thing to everyone.
 */
const FIGURE = /\d+(?::\d+)?/g;
const shown = new Set<string>();
const readouts: { label: string; value: string; ghost: string }[] = [];
for (const row of t.limits) {
  const figures = row.limit.match(FIGURE) ?? [];
  const value = figures[0];
  if (figures.length !== 1 || value === undefined || shown.has(value)) continue;
  shown.add(value);
  // The unlit segments behind the value: every digit as an 8, separators kept.
  readouts.push({ label: row.what, value, ghost: value.replace(/\d/g, '8') });
}
---

<section class="tt-hero">
  <div class="tt-hero-copy">
    {
      /* The product plate. Its LED is the power light — the red tally lives on
         the monitor, where the beat-reactive one sits in the app (docs/03 §1). */
    }
    <p class="tt-eyebrow">
      <span class="tt-plate">
        <span class="tt-led" data-on="true" aria-hidden="true"></span>
        TickTune
      </span>
    </p>

    <h1 class="tt-headline">
      {
        lines.map((line, i) => (
          <span class="tt-line" style={`--i: ${i}`}>
            {line}
            {i < lines.length - 1 ? ' ' : ''}
          </span>
        ))
      }
    </h1>
    <p class="tt-sub">{t.heroSub}</p>

    <div class="tt-actions">
      <a class="tt-key tt-key-primary tt-cta" href="/app/">{common.openApp}</a>
    </div>
  </div>

  <figure class="tt-monitor">
    <span class="tt-screws tt-screws-l" aria-hidden="true"></span>
    <span class="tt-screws tt-screws-r" aria-hidden="true"></span>
    {/* Hardware labelling, not content: "ON AIR" is a studio sign, not copy. */}
    <div class="tt-monitor-strip" aria-hidden="true">
      <span class="tt-onair"><span class="tt-onair-lamp"></span>On Air</span>
      <span class="tt-monitor-leds">
        <span class="tt-led" data-on="true"></span>
        <span class="tt-led" data-on="true"></span>
        <span class="tt-led"></span>
      </span>
    </div>

    <div class="tt-screen">
      <div class="tt-picture">
        <!--
          The real capture — P7 slice C, replacing the P6 placeholder.

          Recorded by `scripts/make-demo.ts` driving the SHIPPED build: gate, import,
          visualizer, a running countdown. Nothing here is a mock-up, so the hero
          cannot claim behaviour the app does not have — if the visualizer breaks,
          the next capture breaks with it.

          Explicit `width`/`height` and the same 960×540 box as the placeholder: this
          is the LCP element, and reserving the box up front is most of what keeps
          CLS at zero for the Lighthouse ≥ 95 exit criterion (`13 §5`).

          No audio track at all — it is muted, so those bytes would be pure waste.
          `poster` is a real frame, so something paints before the video arrives.

          ⚠️ **One source, H.264 only, and that was measured rather than assumed.**
          This shipped briefly with a VP9/WebM `<source>` first on the usual "WebM
          for size, MP4 for reach" reasoning. Both halves were wrong here: the WebM
          encoded LARGER (140 KB vs 119 KB) at equivalent quality, and WebKit stalled
          on it — every landing spec timed out in `page.goto` waiting for `load`,
          thirteen of them, because Safari sat on the first source instead of falling
          through. A second format cost bytes AND compatibility and bought nothing.
        -->
        <video
          class="tt-hero-video"
          src="/demo/hero.mp4"
          poster="/demo/hero-poster.webp"
          width="960"
          height="540"
          autoplay
          muted
          loop
          playsinline
          aria-label={t.heroMediaAlt}></video>

        <!--
          Shown INSTEAD of the video under `prefers-reduced-motion` — `03 §8` treats
          looping decoration as motion, and a hero that loops forever is exactly
          that.

          ⚠️ Honest limitation: this hides the video, it does not stop it
          downloading. Suppressing `autoplay` conditionally needs JavaScript, and
          the landing ships **zero** JS by design (`01 §5`, and the single-inline-
          script invariant the build asserts). Removing the motion is the part that
          matters for accessibility; the wasted bytes are the price, and they are
          ~116 KB rather than something worth breaking the invariant over.
        -->
        <img
          class="tt-hero-still"
          src="/demo/hero-poster.webp"
          alt={t.heroMediaAlt}
          width="960"
          height="540"
          decoding="async"
        />
      </div>
      {/* Smoked glass: a reflection and a vignette over the picture. */}
      <span class="tt-glass" aria-hidden="true"></span>
    </div>

    {
      readouts.length > 0 && (
        <div class="tt-gauges" style={`--n: ${readouts.length}`} aria-hidden="true">
          {readouts.map((r, i) => (
            <div class="tt-gauge" style={`--i: ${i}`}>
              <span class="tt-window" data-ghost={r.ghost}>
                <span class="tt-le" />
                <span class="tt-digits">{r.value}</span>
              </span>
              <span class="tt-gauge-label">{r.label}</span>
            </div>
          ))}
        </div>
      )
    }
  </figure>
</section>

<style>
  .tt-hero {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(var(--tt-space-7), 5vw, 4.5rem);
    align-items: center;
    padding: var(--tt-space-7) 0 var(--tt-space-9);
  }

  /* ── The copy ─────────────────────────────────────────────────────────── */

  .tt-eyebrow {
    display: flex;
    gap: var(--tt-space-3);
    align-items: center;
    margin-bottom: var(--tt-space-5);
  }
  /* The rule that runs from the plate towards the monitor. */
  .tt-eyebrow::after {
    flex: 0 1 7rem;
    height: 0;
    content: '';
    border-top: 1px solid rgb(0 0 0 / 65%);
    border-bottom: 1px solid rgb(255 255 255 / 6%);
  }
  .tt-plate {
    display: inline-flex;
    gap: var(--tt-space-2);
    align-items: center;
    padding: 0.4rem 0.7rem;
    font-family: var(--font-display);
    font-size: var(--tt-text-xs);
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-tt-muted);
    background: var(--color-tt-void);
    border: 1px solid var(--color-tt-line);
    border-radius: var(--tt-radius-xs);
    box-shadow:
      var(--tt-shadow-pressed),
      0 1px 0 rgb(255 255 255 / 4%);
  }

  .tt-headline {
    font-family: var(--font-display);
    /* Capped so the longest sentence ("Đồng hồ của bạn.") holds one line in
       the copy column at every desktop width. */
    font-size: clamp(2.75rem, 0.9rem + 3.6vw, 4.25rem);
    font-weight: 600;
    line-height: 1.06;
    letter-spacing: -0.012em;
    color: var(--color-tt-text);
  }
  .tt-line {
    display: block;
  }
  /* "Your machine." — the line the whole product is built around. */
  .tt-line:last-child {
    color: var(--color-tt-signal);
  }

  .tt-sub {
    max-width: 34rem;
    margin-top: var(--tt-space-5);
    font-size: var(--tt-text-lg);
    line-height: 1.6;
    color: var(--color-tt-muted);
    text-wrap: pretty;
  }

  .tt-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--tt-space-4);
    align-items: center;
    margin-top: var(--tt-space-6);
  }
  /* The large keycap: size only — colour, border and states stay the
     primitive's (.tt-key-primary in global.css). */
  .tt-cta {
    min-height: 52px;
    padding-inline: var(--tt-space-6);
    font-size: var(--tt-text-base);
    letter-spacing: 0.1em;
  }

  /* ── The monitor ──────────────────────────────────────────────────────── */

  .tt-monitor {
    position: relative;
    container-type: inline-size;
    margin: 0;
    padding: var(--tt-space-3) var(--tt-space-4) var(--tt-space-4);
    background-color: var(--color-tt-surface);
    border: 1px solid var(--color-tt-line);
    border-radius: var(--tt-radius-lg);
    box-shadow:
      var(--tt-shadow-panel),
      0 40px 90px -40px rgb(255 178 63 / 16%);
  }

  /* Four screws, two per strip: a domed head with a slot. They sit in the
     bezel's corners, clear of the strip and the readouts.

     Elements, not `::before`/`::after` on the figure: axe treats an absolutely
     positioned pseudo-element with a background on ANY ancestor of a text node
     as possibly covering it, and reported every label in the monitor as
     unmeasurable. A sibling it can see is measured; these overlap no text. */
  .tt-screws {
    position: absolute;
    top: 9px;
    bottom: 9px;
    width: 8px;
    pointer-events: none;
    content: '';
    background:
      linear-gradient(135deg, transparent 40%, rgb(0 0 0 / 70%) 40% 60%, transparent 60%) top / 8px
        8px no-repeat,
      radial-gradient(circle closest-side, #8b8274 0 35%, #4d463d 60%, #1c1a16 88%, transparent)
        top / 8px 8px no-repeat,
      linear-gradient(45deg, transparent 40%, rgb(0 0 0 / 70%) 40% 60%, transparent 60%) bottom /
        8px 8px no-repeat,
      radial-gradient(circle closest-side, #8b8274 0 35%, #4d463d 60%, #1c1a16 88%, transparent)
        bottom / 8px 8px no-repeat;
  }
  .tt-screws-l {
    left: 9px;
  }
  .tt-screws-r {
    right: 9px;
  }

  .tt-monitor-strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 var(--tt-space-4) var(--tt-space-3);
  }

  /* The ON AIR sign, lit. Danger on its 7% tint is 4.82:1 — and the glow is a
     BOX shadow on purpose: axe blends a text-shadow into the background, and a
     45% red text glow measured 4.42 (the first cut of this sign failed). */
  .tt-onair {
    display: inline-flex;
    gap: var(--tt-space-2);
    align-items: center;
    padding: 0.3rem 0.55rem;
    font-family: var(--font-display);
    font-size: var(--tt-text-xs);
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-tt-danger);
    background: color-mix(in srgb, var(--color-tt-danger) 7%, var(--color-tt-surface));
    border: 1px solid color-mix(in srgb, var(--color-tt-danger) 55%, transparent);
    border-radius: var(--tt-radius-xs);
    box-shadow:
      0 0 16px -4px rgb(255 59 48 / 45%),
      inset 0 0 10px rgb(255 59 48 / 10%);
  }
  .tt-onair-lamp {
    width: 7px;
    height: 7px;
    background: var(--color-tt-danger);
    border-radius: 50%;
    box-shadow: 0 0 8px var(--color-tt-danger);
  }

  .tt-monitor-leds {
    display: inline-flex;
    gap: var(--tt-space-2);
  }

  .tt-screen {
    position: relative;
    overflow: hidden;
    background: #050504;
    border-radius: var(--tt-radius-sm);
    box-shadow:
      0 0 0 1px #000,
      0 0 0 4px rgb(0 0 0 / 35%),
      0 1px 0 4px rgb(255 255 255 / 4%);
  }
  .tt-hero-video,
  .tt-hero-still {
    display: block;
    width: 100%;
    height: auto;
  }

  /* The still is the reduced-motion alternative; the video is the default. */
  .tt-hero-still {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .tt-hero-video {
      display: none;
    }
    .tt-hero-still {
      display: block;
    }
  }

  .tt-glass {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(
        164deg,
        rgb(255 255 255 / 7%) 0%,
        rgb(255 255 255 / 2%) 34%,
        transparent 34.5%
      ),
      radial-gradient(130% 100% at 50% 45%, transparent 62%, rgb(0 0 0 / 45%));
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 5%);
  }

  /* ── Readouts ─────────────────────────────────────────────────────────── */

  /* One column per readout, however many the limits table yields; the digits
     scale with the monitor (container units), not with the window. */
  .tt-gauges {
    --tt-gauge-size: clamp(1rem, 3.6cqi, 1.375rem);

    display: grid;
    grid-template-columns: repeat(var(--n, 4), minmax(0, 1fr));
    gap: var(--tt-space-4) var(--tt-space-2);
    padding: var(--tt-space-4) var(--tt-space-3) 0;
  }
  .tt-gauge {
    display: grid;
    gap: var(--tt-space-2);
    align-content: start;
  }

  /* A recessed LCD window. The unlit segments are the window's own generated
     content, aligned under the lit digits: axe never treats generated content
     as text, and the whole strip is aria-hidden, so the 8s reach nobody. */
  .tt-window {
    position: relative;
    display: flex;
    gap: 0.4em;
    align-items: center;
    justify-content: flex-end;
    padding: 0.55rem 0.5rem;
    background: #0b0a08;
    border: 1px solid #000;
    border-radius: var(--tt-radius-xs);
    box-shadow:
      inset 0 2px 6px rgb(0 0 0 / 70%),
      0 1px 0 rgb(255 255 255 / 5%);
  }
  .tt-window::before {
    position: absolute;
    top: 0;
    right: 0.5rem;
    bottom: 0;
    display: flex;
    align-items: center;
    font-family: var(--font-digit);
    font-size: var(--tt-gauge-size);
    line-height: 1;
    color: rgb(245 238 220 / 7%);
    content: attr(data-ghost);
  }
  /* Generated, not typed: a lone math symbol is text axe cannot evaluate
     ("non-BMP"), and the strip is decorative (aria-hidden) anyway. */
  .tt-le::before {
    content: '≤';
  }
  .tt-le {
    margin-right: auto;
    font-family: var(--font-mono);
    font-size: var(--tt-text-sm);
    line-height: 1;
    color: var(--color-tt-muted);
  }
  .tt-digits {
    position: relative;
    font-family: var(--font-digit);
    font-size: var(--tt-gauge-size);
    line-height: 1;
    color: var(--color-tt-digit);
    text-shadow: 0 0 10px rgb(245 238 220 / 35%);
  }
  .tt-gauge-label {
    font-family: var(--font-display);
    font-size: var(--tt-text-xs);
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-tt-muted);
  }

  /* ── Power-on ─────────────────────────────────────────────────────────────
     One sequence, ~2 s: plate → headline, line by line → sub → keycap; the
     screen warms up from a beam, the status LEDs come up, the readouts run a
     lamp test, and the ON AIR sign lights LAST. Every keyframe's end state is
     the element's own style, so nothing is held after the run (`backwards`
     fill only), and none of it exists under reduced motion. */
  @media (prefers-reduced-motion: no-preference) {
    .tt-plate {
      animation: tt-wipe-x 560ms var(--ease-tt) 60ms backwards;
    }
    .tt-eyebrow::after {
      transform-origin: left;
      animation: tt-draw 700ms var(--ease-tt) 260ms backwards;
    }
    .tt-line {
      animation: tt-rise 760ms var(--ease-tt) backwards;
      animation-delay: calc(180ms + var(--i, 0) * 120ms);
    }
    .tt-sub {
      animation: tt-wipe-y 760ms var(--ease-tt) 560ms backwards;
    }
    .tt-actions {
      animation: tt-key-up 560ms var(--ease-tt) 760ms backwards;
    }

    .tt-screen::after {
      position: absolute;
      top: 50%;
      right: 0;
      left: 0;
      height: 2px;
      margin-top: -1px;
      pointer-events: none;
      content: '';
      background: linear-gradient(90deg, transparent, #fff6e4 18% 82%, transparent);
      box-shadow: 0 0 14px 3px rgb(255 246 228 / 55%);
      opacity: 0;
      animation: tt-beam 760ms cubic-bezier(0.3, 0.7, 0.2, 1) 220ms backwards;
    }
    .tt-picture {
      animation: tt-picture-on 820ms cubic-bezier(0.3, 0.7, 0.2, 1) 560ms backwards;
    }

    .tt-monitor-leds .tt-led:nth-child(1) {
      animation: tt-led-off 420ms linear;
    }
    .tt-monitor-leds .tt-led:nth-child(2) {
      animation: tt-led-off 620ms linear;
    }

    .tt-window::before {
      animation: tt-lamp-test 380ms steps(1, end);
      animation-delay: calc(1100ms + var(--i, 0) * 130ms);
    }
    .tt-digits {
      animation: tt-hold-dark 380ms linear backwards;
      animation-delay: calc(1100ms + var(--i, 0) * 130ms);
    }

    .tt-onair {
      animation: tt-sign-on 2100ms linear;
    }
    .tt-onair-lamp {
      animation: tt-lamp-on 2100ms linear;
    }
  }

  @keyframes tt-wipe-x {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0);
    }
  }
  @keyframes tt-draw {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }
  /* Glyphs above the line box (Vietnamese stacks its diacritics) stay inside
     the clip: the region starts 0.4em above the box and ends past it. */
  @keyframes tt-rise {
    from {
      clip-path: inset(-0.4em -0.2em calc(100% + 0.4em) -0.2em);
      transform: translateY(0.28em);
    }
    to {
      clip-path: inset(-0.4em -0.2em -0.35em -0.2em);
      transform: translateY(0);
    }
  }
  @keyframes tt-wipe-y {
    from {
      clip-path: inset(-0.3em 0 calc(100% + 0.3em) 0);
    }
    to {
      clip-path: inset(-0.3em 0 -0.4em 0);
    }
  }
  @keyframes tt-key-up {
    from {
      filter: brightness(0.35) saturate(0.3);
      transform: translateY(10px);
    }
    to {
      filter: brightness(1) saturate(1);
      transform: translateY(0);
    }
  }
  @keyframes tt-beam {
    0% {
      opacity: 1;
      transform: scaleX(0);
    }
    45% {
      opacity: 1;
      transform: scaleX(1);
    }
    100% {
      opacity: 0;
      transform: scaleX(1) scaleY(40);
    }
  }
  @keyframes tt-picture-on {
    0% {
      clip-path: inset(49.6% 0 49.6% 0);
      filter: brightness(2.4) saturate(0);
    }
    55% {
      clip-path: inset(0);
      filter: brightness(1.5) saturate(0.6);
    }
    100% {
      clip-path: inset(0);
      filter: brightness(1) saturate(1);
    }
  }
  /* "Off for the whole run, then the element's own (lit) style." */
  @keyframes tt-led-off {
    from,
    to {
      background: var(--color-tt-line);
      box-shadow: inset 0 0 0 1px rgb(0 0 0 / 45%);
    }
  }
  /* Every segment lit at once — the self-test real displays run at power-on. */
  @keyframes tt-lamp-test {
    from,
    to {
      color: rgb(245 238 220 / 80%);
      text-shadow: 0 0 10px rgb(245 238 220 / 35%);
    }
  }
  @keyframes tt-hold-dark {
    from,
    to {
      clip-path: inset(0 0 0 100%);
    }
  }
  /* Dark until the very end of the run, then two flickers and on. */
  @keyframes tt-sign-on {
    0%,
    84%,
    88%,
    93% {
      color: var(--color-tt-muted);
      background: var(--color-tt-surface);
      border-color: var(--color-tt-line);
      box-shadow: none;
    }
    86%,
    90% {
      color: var(--color-tt-danger);
      background: color-mix(in srgb, var(--color-tt-danger) 7%, var(--color-tt-surface));
      border-color: color-mix(in srgb, var(--color-tt-danger) 55%, transparent);
      box-shadow: 0 0 16px -4px rgb(255 59 48 / 45%);
    }
  }
  @keyframes tt-lamp-on {
    0%,
    84%,
    88%,
    93% {
      background: #3a1714;
      box-shadow: inset 0 0 0 1px rgb(0 0 0 / 50%);
    }
    86%,
    90% {
      background: var(--color-tt-danger);
      box-shadow: 0 0 8px var(--color-tt-danger);
    }
  }
</style>
