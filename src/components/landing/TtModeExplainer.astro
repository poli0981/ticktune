---
import type { StaticDict } from '../../i18n/static/en';

/**
 * Mode explainer — docs/03 §3 item 1, the three modes of docs/02 §1.
 *
 * The closing note states docs/06 §5's "sources do not mix" rule, because that
 * is the one thing about the modes people discover by being refused.
 *
 * Rack module 02: three channel modules, each with its channel number on a
 * seven-segment window. The number is the entry's position, not copy, and it
 * is decorative — the list already conveys the order.
 */

interface Props {
  t: StaticDict['landing'];
}

const { t } = Astro.props;
---

<section class="tt-unit" aria-labelledby="tt-modes">
  <div class="tt-unit-head">
    <h2 id="tt-modes">{t.modesTitle}</h2>
  </div>
  <ul class="tt-grid">
    {t.modes.map((m, i) => (
      <li class="tt-panel tt-mode">
        <span class="tt-channel" aria-hidden="true">
          <span class="tt-channel-digit">{i + 1}</span>
        </span>
        <h3>{m.name}</h3>
        <p>{m.body}</p>
      </li>
    ))}
  </ul>
  <p class="tt-unit-note">
    <span class="tt-led tt-note-led" data-on="true" aria-hidden="true"></span>
    <span>{t.modesNote}</span>
  </p>
</section>

<style>
  .tt-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0 var(--tt-space-4);
    padding: 0;
    list-style: none;
  }

  /* Rows from the list's grid (subgrid), columns of its own: channel | name,
     then the body across both. */
  .tt-mode {
    display: grid;
    grid-row: span 2;
    grid-template-rows: subgrid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--tt-space-4);
    align-items: center;
    padding: var(--tt-space-5) var(--tt-space-5) var(--tt-space-6);
  }

  /* A one-digit LCD window; its unlit "8" is generated content inside an
     aria-hidden window, so it is never read or contrast-checked as text. */
  .tt-channel {
    position: relative;
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    background: #0b0a08;
    border: 1px solid #000;
    border-radius: var(--tt-radius-xs);
    box-shadow:
      inset 0 2px 6px rgb(0 0 0 / 70%),
      0 1px 0 rgb(255 255 255 / 5%);
  }
  .tt-channel::before {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-family: var(--font-digit);
    font-size: var(--tt-text-xl);
    line-height: 1;
    color: rgb(255 178 63 / 8%);
    content: '8';
  }
  .tt-channel-digit {
    position: relative;
    font-family: var(--font-digit);
    font-size: var(--tt-text-xl);
    line-height: 1;
    color: var(--color-tt-signal);
    text-shadow: 0 0 10px rgb(255 178 63 / 45%);
  }

  h3 {
    font-family: var(--font-display);
    font-size: var(--tt-text-xl);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: 0.02em;
    color: var(--color-tt-signal);
  }
  p {
    grid-column: 1 / -1;
    align-self: start;
    font-size: var(--tt-text-base);
    line-height: 1.65;
    color: var(--color-tt-muted);
    text-wrap: pretty;
  }

  /* The note's LED sits on the first line, whatever the wrap. */
  .tt-note-led {
    transform: translateY(-0.1em);
  }
</style>
