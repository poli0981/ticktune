---
import type { StaticDict } from '../../i18n/static/en';

/**
 * Limits table — docs/03 §3 item 1.
 *
 * ⚠️ These are the numbers the importer actually enforces (`02 §1`, `06 §5`),
 * and CLAUDE.md's invariant 4 calls them "spec, not suggestions". They live in
 * the dictionary as prose rather than being imported from the engine constants
 * on purpose: the engine values are milliseconds and counts, the page needs
 * "up to 10:02" in two languages, and deriving one from the other would put
 * formatting logic on a static page to save copying six rows. The live
 * checklist re-reads them against the app.
 *
 * Rack module 03, an engineering spec sheet. The figures inside each limit are
 * picked out by pattern, not by hand — the cell's text is exactly the
 * dictionary's, only wrapped.
 */

interface Props {
  t: StaticDict['landing'];
}

const { t } = Astro.props;

/** "up to 95 files" → ["up to ", "95", " files"]: odd indexes are the figures. */
const parts = (limit: string) => limit.split(/(\d+(?::\d+)?)/);
---

<section class="tt-unit" aria-labelledby="tt-limits">
  <div class="tt-unit-head">
    <h2 id="tt-limits">{t.limitsTitle}</h2>
  </div>
  <div class="tt-panel tt-sheet">
    <table>
      <thead>
        <tr>
          <th scope="col">{t.limitsHead.what}</th>
          <th scope="col">{t.limitsHead.limit}</th>
        </tr>
      </thead>
      <tbody>
        {
          t.limits.map((row) => (
            <tr>
              <th scope="row">{row.what}</th>
              <td>
                {parts(row.limit).map((part, i) =>
                  i % 2 === 1 ? <span class="tt-fig">{part}</span> : part,
                )}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  <p class="tt-unit-note">{t.limitsNote}</p>
</section>

<style>
  .tt-sheet {
    max-width: 46rem;
    padding: var(--tt-space-2) var(--tt-space-4) var(--tt-space-3);
  }
  table {
    width: 100%;
    font-size: var(--tt-text-sm);
    font-variant-numeric: tabular-nums;
    border-collapse: collapse;
  }
  th,
  td {
    padding: var(--tt-space-3) var(--tt-space-2);
    text-align: left;
    vertical-align: baseline;
  }

  /* The engraved header row. */
  thead th {
    padding-block: var(--tt-space-3);
    font-family: var(--font-display);
    font-size: var(--tt-text-xs);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-tt-muted);
    border-bottom: 1px solid rgb(0 0 0 / 70%);
    box-shadow: 0 1px 0 rgb(255 255 255 / 5%);
  }

  tbody tr + tr > * {
    border-top: 1px solid var(--color-tt-line);
  }
  tbody th {
    font-weight: 500;
    color: var(--color-tt-text);
  }
  td {
    font-family: var(--font-mono);
    color: var(--color-tt-muted);
  }
  .tt-fig {
    color: var(--color-tt-signal);
  }
</style>
