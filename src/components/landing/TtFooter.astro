---
import type { StaticDict } from '../../i18n/static/en';
import { TT_LEGAL_LINKS, ttLegalHref } from '../../lib/tt-legal-const';

/**
 * Landing footer — legal links + the GPL-3.0 source offer.
 *
 * ⚠️ The source-offer link is not decoration. It has been on the page since the
 * very first deploy because **GPL-3.0 §6** requires the hosted build to offer
 * its corresponding source, and `src/pages/index.astro`'s original stub carried
 * a comment saying the real landing must keep it in the footer. Do not remove it.
 *
 * 🔴 **`lang` is not decoration.** P6 slice B pointed `TT_LEGAL_LINKS` at on-site
 * routes, and those constants are the **Vietnamese** ones. This component is the
 * only one of the three legal-link call sites that cannot read `i18n.lang` —
 * there is no runtime here, so the language has to be handed down from the page.
 * Read the constant directly and the VI footer keeps working by accident while
 * the EN footer links every document to its Vietnamese version: four valid URLs,
 * four 200s, all four wrong. `tests/e2e/legal.spec.ts` asserts the EN footer for
 * exactly this reason.
 *
 * v1.1 "Rack Unit": the rack's rear panel — engraved labels over the legal
 * links, the contacts and the source offer, then a serial plate.
 */

interface Props {
  t: StaticDict['landing'];
  common: StaticDict['common'];
  legal: StaticDict['legal'];
  lang: 'vi' | 'en' | 'ja';
}

const { t, common, legal, lang } = Astro.props;

/**
 * The published role addresses — chosen 2026-10-20 from the owner's aliases.
 * Addresses are not translated, so they live here rather than in the
 * dictionaries (whose untranslated-string guard would flag them).
 */
const contacts = [
  { label: t.contactPress, address: 'press@poli0981.dev' },
  { label: t.contactCollab, address: 'collab@poli0981.dev' },
  { label: t.contactSecurity, address: 'security@poli0981.dev' },
];

const docs = [
  { href: ttLegalHref('eula', lang), label: legal.docs.eula },
  { href: ttLegalHref('disclaimer', lang), label: legal.docs.disclaimer },
  { href: ttLegalHref('privacy', lang), label: legal.docs.privacy },
  { href: ttLegalHref('thirdParty', lang), label: legal.docs.thirdParty },
];
---

<footer class="tt-footer" aria-labelledby="tt-legal">
  <div class="tt-panel tt-rear">
    <div>
      <h2 id="tt-legal" class="tt-label">
        {t.legalTitle}
      </h2>
      <ul class="tt-docs">
        {docs.map((d) => (
          <li>
            <a href={d.href} rel="noopener noreferrer">
              {d.label}
            </a>
          </li>
        ))}
      </ul>
      <p class="tt-note">{t.legalNote}</p>
    </div>

    <div>
      <h2 class="tt-label">{t.contactTitle}</h2>
      <ul class="tt-contacts">
        {contacts.map((c) => (
          <li>
            <span class="tt-contact-label">{`${c.label}:`}</span>{' '}
            <a href={`mailto:${c.address}`}>{c.address}</a>
          </li>
        ))}
      </ul>
    </div>

    <p class="tt-source">
      <a class="tt-key tt-key-sm" href={TT_LEGAL_LINKS.repo} rel="noopener noreferrer">
        {common.sourceOffer}
      </a>
    </p>
  </div>

  {/* The serial plate: product name and vents, nothing to read. */}
  <div class="tt-serial" aria-hidden="true">
    <span class="tt-led" data-on="true"></span>
    <span class="tt-serial-name">TickTune</span>
    <span class="tt-vents"></span>
  </div>
</footer>

<style>
  .tt-footer {
    padding-block: var(--tt-space-7) var(--tt-space-8);
    border-top: 1px solid rgb(0 0 0 / 70%);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 5%);
  }

  .tt-rear {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr) auto;
    gap: var(--tt-space-7);
    padding: var(--tt-space-6);
  }

  h2 {
    margin-bottom: var(--tt-space-4);
  }

  .tt-docs {
    display: grid;
    gap: var(--tt-space-2);
    padding: 0;
    list-style: none;
  }
  .tt-docs a,
  .tt-contacts a {
    text-decoration: underline;
    text-decoration-color: var(--color-tt-outline);
    text-underline-offset: 4px;
    transition:
      color var(--duration-tt-fast) var(--ease-tt),
      text-decoration-color var(--duration-tt-fast) var(--ease-tt);
  }
  .tt-docs a {
    font-size: var(--tt-text-base);
    color: var(--color-tt-text);
  }
  .tt-docs a:hover,
  .tt-contacts a:hover {
    color: var(--color-tt-signal);
    text-decoration-color: currentcolor;
  }

  .tt-note {
    margin-top: var(--tt-space-4);
    font-size: var(--tt-text-sm);
    line-height: 1.6;
    color: var(--color-tt-muted);
    text-wrap: pretty;
  }

  /* Label | address, aligned down the list: each row adopts the list's two
     columns (subgrid), so the widest label sets the column for all three. */
  .tt-contacts {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--tt-space-3) var(--tt-space-4);
    padding: 0;
    list-style: none;
  }
  .tt-contacts li {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: subgrid;
    align-items: baseline;
  }
  .tt-contact-label {
    font-family: var(--font-display);
    font-size: var(--tt-text-xs);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-tt-muted);
  }
  .tt-contacts a {
    font-family: var(--font-mono);
    font-size: var(--tt-text-sm);
    color: var(--color-tt-signal);
    overflow-wrap: anywhere;
  }

  .tt-source {
    align-self: start;
  }

  /* ── The serial plate ───────────────────────────────────────────────── */
  .tt-serial {
    display: flex;
    gap: var(--tt-space-3);
    align-items: center;
    margin-top: var(--tt-space-5);
    padding-inline: var(--tt-space-2);
  }
  .tt-serial-name {
    font-family: var(--font-display);
    font-size: var(--tt-text-xs);
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-tt-muted);
  }
  /* Vent slots, machined into the chassis. */
  .tt-vents {
    flex: 1;
    height: 8px;
    margin-left: var(--tt-space-4);
    background: repeating-linear-gradient(90deg, #060504 0 22px, transparent 22px 30px);
    border-radius: 2px;
    box-shadow: 0 1px 0 rgb(255 255 255 / 4%);
    mask-image: linear-gradient(90deg, black 70%, transparent);
  }
</style>
