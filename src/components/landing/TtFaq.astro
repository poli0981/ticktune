---
import type { StaticDict } from '../../i18n/static/en';

/**
 * Landing FAQ — docs/03 §3 item 1, and the home of one specific requirement.
 *
 * ⚠️ **docs/04 §2 item 6** — of the six things the S2 decision demanded, this is
 * the only one that lives outside the app:
 *
 * > "Say it where users decide to trust it — the landing FAQ states the
 * >  visible/hidden distinction plainly rather than burying it in the EULA."
 *
 * S2 measured a hidden tab finishing **2 m 57 s late**, and the remedy failed
 * too, so the promise was re-scoped rather than the bug fixed (`04 §2` option
 * 3). The first FAQ entry is that disclosure. It is asserted by
 * `tests/e2e/landing.spec.ts` in both languages — if it is ever edited away,
 * that spec goes red, which is the point.
 *
 * `<details>` is used rather than a JS accordion: the site ships exactly one
 * inline script and this needs none. Every answer is in the DOM for crawlers
 * (docs/07 §5) whether or not it is open.
 *
 * Rack module 04. Each entry is a module whose LED is lit while it is open;
 * the native disclosure marker is replaced by a chevron, and the LED and the
 * chevron are both decoration — `<summary>` already announces its state.
 */

interface Props {
  t: StaticDict['landing'];
  faq: StaticDict['faq'];
}

const { t, faq } = Astro.props;
---

<section class="tt-unit" aria-labelledby="tt-faq">
  <div class="tt-unit-head">
    <h2 id="tt-faq">{t.faqTitle}</h2>
  </div>
  <div class="tt-faq">
    {faq.map((item, i) => (
      <details open={i === 0}>
        <summary>
          <span class="tt-led" aria-hidden="true" />
          <span class="tt-q">{item.q}</span>
        </summary>
        <p>{item.a}</p>
      </details>
    ))}
  </div>
</section>

<style>
  .tt-faq {
    display: grid;
    gap: var(--tt-space-2);
  }

  details {
    background: var(--color-tt-surface);
    border: 1px solid var(--color-tt-line);
    border-radius: var(--tt-radius-md);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 3.5%),
      0 1px 0 rgb(0 0 0 / 40%);
    transition: border-color var(--duration-tt-fast) var(--ease-tt);
  }
  details[open] {
    border-color: color-mix(in srgb, var(--color-tt-outline) 55%, var(--color-tt-line));
  }

  summary {
    display: flex;
    gap: var(--tt-space-3);
    align-items: center;
    padding: var(--tt-space-4) var(--tt-space-4) var(--tt-space-4) var(--tt-space-4);
    font-size: var(--tt-text-base);
    font-weight: 500;
    line-height: 1.45;
    color: var(--color-tt-text);
    cursor: pointer;
    list-style: none;
    border-radius: var(--tt-radius-md);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover .tt-q {
    color: var(--color-tt-signal);
  }
  .tt-q {
    flex: 1;
    text-wrap: pretty;
    transition: color var(--duration-tt-fast) var(--ease-tt);
  }

  /* The chevron — a flex item, never positioned, so it stays out of axe's
     pseudo-element heuristics. It points down when closed, up when open. */
  summary::after {
    flex: none;
    width: 8px;
    height: 8px;
    margin: 0 var(--tt-space-1) 4px var(--tt-space-2);
    content: '';
    border-right: 2px solid var(--color-tt-muted);
    border-bottom: 2px solid var(--color-tt-muted);
    transform: rotate(45deg);
    transition: transform var(--duration-tt-base) var(--ease-tt);
  }
  details[open] > summary::after {
    margin-bottom: -4px;
    transform: rotate(225deg);
  }

  /* The open entry's LED. Overrides the primitive's unlit colours on purpose:
     the primitive lights from aria-pressed or data-on, and `open` is neither. */
  details[open] > summary .tt-led {
    background: var(--color-tt-signal);
    box-shadow: var(--tt-glow-signal);
  }

  details p {
    max-width: 68ch;
    padding: 0 var(--tt-space-5) var(--tt-space-5) calc(var(--tt-space-4) + 6px + var(--tt-space-3));
    font-size: var(--tt-text-base);
    line-height: 1.7;
    color: var(--color-tt-muted);
    text-wrap: pretty;
  }
</style>
