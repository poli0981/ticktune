---
import TtBase from '../../layouts/TtBase.astro';
import TtHero from './TtHero.astro';
import TtFeatureGrid from './TtFeatureGrid.astro';
import TtModeExplainer from './TtModeExplainer.astro';
import TtLimitsTable from './TtLimitsTable.astro';
import TtFaq from './TtFaq.astro';
import TtFooter from './TtFooter.astro';
import type { StaticDict } from '../../i18n/static/en';

/**
 * The landing page itself — docs/03 §3 item 1, docs/08 §1.
 *
 * Both `/` and `/en/` render THIS, differing only in the dictionary they hand
 * over and the `lang`. That is what "one component per page, strings from typed
 * dictionaries" means in `08 §1`: the markup exists once, so the two languages
 * cannot drift structurally — only their text differs, and that difference is
 * type-checked.
 *
 * The alternates are built here rather than at each page, so the reciprocal
 * pair can never be half-updated.
 *
 * v1.1 "Rack Unit": the page is a rack. Each numbered section is a module
 * (`.tt-unit`) bolted in under a machined seam; the shared module chrome is
 * styled ONCE below, through `:global`, because the sections are separate
 * components that only ever render inside this page.
 */

interface Props {
  t: StaticDict;
  lang: 'vi' | 'en';
}

const { t, lang } = Astro.props;

/** docs/08 §1 — `/` is VI and the x-default; `/en/` is the EN mirror. */
const alternates = [
  { hreflang: 'vi', href: new URL('/', Astro.site).href },
  { hreflang: 'en', href: new URL('/en/', Astro.site).href },
  { hreflang: 'x-default', href: new URL('/', Astro.site).href },
];

const otherHref = lang === 'vi' ? '/en/' : '/';
---

<TtBase title={t.landing.title} description={t.landing.description} {lang} {alternates}>
  <main class="tt-page">
    <!--
      The language switch is a LINK, not a toggle: these are separate routes
      (docs/08 §1), so switching language here is navigation. The app island's
      in-place toggle is a different mechanism for a different surface.
      `hreflang` on the anchor tells assistive tech the target language.
    -->
    {/* ⚠️ The page's ONLY navigation landmark, holding exactly one link —
         tests/e2e/landing.spec.ts clicks `getByRole('navigation').getByRole('link')`. */}
    <nav class="tt-lang" aria-label={t.common.switchToLabel}>
      <a
        class="tt-key tt-key-sm"
        href={otherHref}
        hreflang={lang === 'vi' ? 'en' : 'vi'}
        lang={lang === 'vi' ? 'en' : 'vi'}
      >
        {t.common.switchTo}
      </a>
    </nav>

    <TtHero t={t.landing} common={t.common} />
    <TtFeatureGrid t={t.landing} />
    <TtModeExplainer t={t.landing} />

    {/* Two half-rack modules side by side: the spec sheet and the FAQ. */}
    <div class="tt-split">
      <TtLimitsTable t={t.landing} />
      <TtFaq t={t.landing} faq={t.faq} />
    </div>

    <TtFooter t={t.landing} common={t.common} legal={t.legal} {lang} />
  </main>
</TtBase>

<style>
  .tt-page {
    width: min(76rem, 100% - 4rem);
    margin-inline: auto;
    counter-reset: tt-unit;
  }

  .tt-lang {
    display: flex;
    justify-content: flex-end;
    padding-top: var(--tt-space-5);
  }

  /* Half-rack modules from 75rem; below that the spec sheet would have to wrap
     its labels, so the two stack and the sheet keeps a readable measure. */
  .tt-split {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    column-gap: clamp(var(--tt-space-6), 4vw, var(--tt-space-8));
    align-items: start;
  }
  @media (min-width: 75rem) {
    .tt-split {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* ── Rack module chrome, shared by every numbered section ─────────────────
     A machined seam on top: a dark groove with the light catching its lower
     lip. Drawn with a border and an inset shadow rather than a pseudo-element:
     an absolutely positioned pseudo with a background on an ancestor of text
     makes axe skip the contrast check for everything inside it. */
  .tt-page :global(.tt-unit) {
    padding-block: var(--tt-space-7) var(--tt-space-8);
    border-top: 1px solid rgb(0 0 0 / 70%);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 5%);
  }

  .tt-page :global(.tt-unit-head) {
    display: flex;
    gap: var(--tt-space-4);
    align-items: center;
    margin-bottom: var(--tt-space-6);
    counter-increment: tt-unit;
  }

  /* The engraved module number — decorative, so it is generated content with
     an empty alternative (`/ ''`): generated content is otherwise announced,
     and the alternative is what keeps "01" out of the accessibility tree.
     Deliberately no fallback without it — an engine that cannot hide the
     number from assistive tech gets no number at all. */
  .tt-page :global(.tt-unit-head::before) {
    flex: none;
    padding: 0.3em 0.55em;
    font-family: var(--font-mono);
    font-size: var(--tt-text-xs);
    font-variant-numeric: tabular-nums;
    line-height: 1;
    letter-spacing: 0.08em;
    color: var(--color-tt-muted);
    content: counter(tt-unit, decimal-leading-zero) / '';
    background: var(--color-tt-void);
    border: 1px solid var(--color-tt-line);
    border-radius: var(--tt-radius-xs);
    box-shadow: var(--tt-shadow-pressed);
  }

  /* The rule that runs out to the module's edge. */
  .tt-page :global(.tt-unit-head::after) {
    flex: 1;
    min-width: var(--tt-space-6);
    height: 0;
    content: '';
    border-top: 1px solid rgb(0 0 0 / 65%);
    border-bottom: 1px solid rgb(255 255 255 / 5%);
  }

  .tt-page :global(.tt-unit-head h2) {
    font-family: var(--font-display);
    font-size: var(--tt-text-2xl);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: 0.01em;
    color: var(--color-tt-text);
    text-wrap: balance;
  }

  /* A footnote engraved under a module. */
  .tt-page :global(.tt-unit-note) {
    display: flex;
    gap: var(--tt-space-3);
    align-items: baseline;
    margin-top: var(--tt-space-5);
    font-size: var(--tt-text-sm);
    line-height: 1.6;
    color: var(--color-tt-muted);
    text-wrap: pretty;
  }
</style>
