{
  "name": "ticktune",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "description": "Desktop-only countdown with your own music behind it. 100% client-side.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/poli0981/ticktune.git"
  },
  "homepage": "https://ticktune.net",
  "bugs": "https://github.com/poli0981/ticktune/issues",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/inject-csp-hash.ts && node scripts/make-notices.ts && node scripts/check-budget.ts",
    "preview": "astro preview",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "check": "astro check && svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.worker.json",
    "knip": "knip --no-config-hints",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "guard": "node scripts/guard-no-corpus.mjs",
    "verify:csp": "node scripts/verify-csp.mjs",
    "fixtures": "node scripts/make-fixtures.ts",
    "demo": "node scripts/make-demo.ts"
  },
  "dependencies": {
    "@astrojs/svelte": "9.0.1",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "astro": "7.3.8",
    "dexie": "4.4.6",
    "i18next": "^26.4.3",
    "music-metadata": "12.2.0",
    "svelte": "5.57.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-satteri": "0.4.3",
    "@astrojs/sitemap": "^3.7.4",
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/workers-types": "^5.20261011.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/svelte": "5.4.2",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.12.0",
    "eslint-plugin-svelte": "3.23.1",
    "ffmpeg-static": "^5.3.0",
    "globals": "^17.13.0",
    "happy-dom": "21.0.1",
    "knip": "6.41.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte-check": "4.7.6",
    "svelte-eslint-parser": "^1.9.0",
    "tailwindcss": "4.3.3",
    "typescript": "~5.9",
    "typescript-eslint": "^8.71.1",
    "vitest": "4.1.11",
    "wrangler": "4.149.0"
  }
}
